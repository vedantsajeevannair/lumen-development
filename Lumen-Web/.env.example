# ==============================================================================
# LUMEN Web — build-time configuration
#
# Vite INLINES these at build time; they are not read at runtime. A deployed
# build must therefore be rebuilt when the backend URL changes.
# ==============================================================================

# Absolute origin of the hosted LUMEN backend — the same API the mobile app uses.
# Used by the browser for every REST call and for Socket.IO.
#   hosted:  https://backend.render.com
#   local:   http://localhost:3000
# Leave EMPTY only if something in front of the app reverse-proxies /api to the
# backend on the same origin (in that case set VITE_DEV_PROXY_TARGET below).
VITE_API_BASE_URL=https://backend.render.com

# Only used when VITE_API_BASE_URL is empty: where `npm run dev` proxies /api.
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Socket.IO origin. Defaults to VITE_API_BASE_URL when left empty.
VITE_WS_URL=
