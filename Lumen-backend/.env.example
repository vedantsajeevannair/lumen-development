# ==============================================================================
# LUMEN Backend Environment Configuration Template (Production)
# Rename this file to .env and configure the variables below.
# DO NOT commit the populated .env file to your source control.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database Configuration
# Inside Docker Network: postgresql://<user>:<password>@postgres:5432/<db_name>?schema=public
# If using AWS RDS: postgresql://<user>:<password>@<rds-endpoint>:5432/<db_name>?schema=public
DATABASE_URL="postgresql://lumen:lumen_secret@postgres:5432/lumen_db?schema=public"

# Redis Queue Configuration
# Inside Docker Network: Use the service name "redis"
# If using AWS ElastiCache: Use the primary cache endpoint (e.g. redis://lumen.xxxxxx.ap-south-1.cache.amazonaws.com:6379)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL=redis://default:password@your-elasticache-endpoint:6379

# JSON Web Tokens Configuration (Must generate secure keys in production!)
JWT_SECRET="generate-a-secure-random-32-byte-hex-string-for-access-token"
JWT_REFRESH_SECRET="generate-a-secure-random-32-byte-hex-string-for-refresh-token"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Google Maps (For Map Visualizations, Markers, Reverse Geocoding)
Google_Maps_Api_Key="your-restricted-google-maps-api-key"

# Gemini AI (If used for NLP, otherwise optional)
Gemini_Api_key="your-gemini-api-key"

# AWS S3 Storage Integration
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=lumen-smartcity-storage
# If deployed on ECS/EC2 with IAM Roles, you can leave these blank as AWS SDK resolves them automatically.
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# SMTP Email Configuration (For OTP/Notification Delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-app-password"

# FastAPI AI Service Endpoint
# Inside Docker Network: Use http://fastapi:8000
# If hosted on separate machine: Use the target IP/Domain
FASTAPI_INFERENCE_URL=http://fastapi:8000
FASTAPI_API_KEY=""
