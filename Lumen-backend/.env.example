# ==============================================================================
# LUMEN Backend — environment template
# Copy to .env and fill in. Do not commit the populated .env.
#
# Variables marked REQUIRED are enforced at boot by server/config/env.validation.ts
# — the process exits if they are missing.
# ==============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Comma-free single origin that overrides the CORS allow-list. Leave unset to
# use the built-in local defaults (Vite on :5173 and the Expo dev origins).
# FRONTEND_URL=https://lumen.example.gov

# --- PostgreSQL (REQUIRED) -----------------------------------------------------
# Docker network:  postgresql://<user>:<password>@postgres:5432/<db>?schema=public
# AWS RDS:         postgresql://<user>:<password>@<rds-endpoint>:5432/<db>?schema=public
# RDS requires TLS — keep sslmode=require on managed Postgres.
DATABASE_URL="postgresql://lumen:lumen_secret@postgres:5432/lumen_db?schema=public"

# --- Supabase (REQUIRED) -------------------------------------------------------
# Currently only read by the /health probe (server/health/health.service.ts),
# but env validation refuses to boot without them.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Redis (queues + cache) ----------------------------------------------------
# Docker network: use the service name "redis". ElastiCache: use REDIS_URL.
# With encryption in transit the scheme is rediss:// — TLS is negotiated from it.
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_URL=rediss://your-elasticache-endpoint:6379

# --- Auth ----------------------------------------------------------------------
# Refresh tokens are persisted in the RefreshToken table (7-day lifetime), so
# only the access-token secret is configurable here.
JWT_SECRET="generate-a-secure-random-32-byte-hex-string"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# --- FastAPI computer-vision service -------------------------------------------
# Docker network: http://fastapi:8000
FASTAPI_INFERENCE_URL=http://fastapi:8000
FASTAPI_API_KEY=""

# --- AWS S3 (complaint media) --------------------------------------------------
# Region and bucket are always required.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=lumen-smartcity-storage
# Static keys are only for local development. On EC2 (instance profile), ECS
# (task role) or EKS (IRSA), leave BOTH unset — the SDK's default provider chain
# resolves the role, and setting them would override it.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- SMTP (OTP + notification email) -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-app-password"

# --- Google Maps (geocoding, markers) ------------------------------------------
GOOGLE_MAPS_API_KEY="your-restricted-google-maps-api-key"

# --- Firebase (mobile push notifications) --------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Stripe (payments) ---------------------------------------------------------
STRIPE_SECRET_KEY=""
