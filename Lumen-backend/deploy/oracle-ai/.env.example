# Copy to .env beside docker-compose.yml on the instance, then fill in.
# Never commit the filled-in copy — it holds the shared inference secret.

# Public hostname Caddy requests a Let's Encrypt certificate for.
# <public-ip>.sslip.io resolves to that IP with no domain registration; see the
# Caddyfile for why a real name is needed rather than the bare IP.
AI_HOSTNAME=<instance-public-ip>.sslip.io

# Weights baked into the image by the Dockerfile.
MODEL_PATH=/app/models/best.onnx

# The exported ONNX graph has nms=True with conf=0.001 baked in, so this is the
# only threshold that actually filters detections.
CONFIDENCE_THRESHOLD=0.25

# One thread per OCPU. Oversubscribing makes batched inference slower.
TORCH_NUM_THREADS=2

# This service fetches whatever image URL the backend hands it, so keep the
# link-local and private-range block on.
PREVENT_SSRF=True

# Must match FASTAPI_API_KEY on the Render backend. Generate with:
#   openssl rand -hex 32
FASTAPI_API_KEY=
