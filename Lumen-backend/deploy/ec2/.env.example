# EC2 production environment. Copy to .env next to docker-compose.prod.yml.
# Everything the app reads is documented in ../../.env.example — this file only
# highlights what changes when the dependencies are managed AWS services.

NODE_ENV=production
PORT=3000

# RDS. TLS is required — keep sslmode=require.
DATABASE_URL="postgresql://lumen:CHANGEME@lumen.abc123.ap-south-1.rds.amazonaws.com:5432/lumen_db?schema=public&sslmode=require"

# ElastiCache. Use rediss:// when encryption in transit is enabled.
REDIS_URL="rediss://lumen.abc123.cache.amazonaws.com:6379"

# Comma-separated browser origins allowed by CORS — must include the deployed
# web app, or the browser blocks every request before it reaches the server.
FRONTEND_URL="https://lumen.example.gov"

JWT_SECRET="CHANGEME-generate-a-32-byte-hex-string"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Required by env validation; the process exits without them.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="CHANGEME"

# S3. Leave the key pair UNSET so the SDK uses the EC2 instance profile.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=lumen-smartcity-storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

FASTAPI_INFERENCE_URL=http://fastapi:8000
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
