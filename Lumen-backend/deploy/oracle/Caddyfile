# LUMEN reverse proxy.
#
# Caddy obtains and renews a Let's Encrypt certificate automatically; there is no
# certbot step and no renewal cron. It needs port 80 reachable from the internet
# for the ACME challenge — see setup.sh for the two firewalls that must both
# allow it.
#
# Everything is served from one origin. That is not just tidiness: same-origin
# means the browser never makes a cross-origin request, so the CORS allow-list
# that bites every split deployment is simply not in play here. Build the web app
# with an EMPTY VITE_API_BASE_URL so it calls /api on its own origin — the Vite
# config already supports exactly this arrangement.

# No `email` directive. In Caddy it is a *global* option, not a site-level one —
# putting it inside the site block fails to parse outright. Left unset, Caddy
# registers an anonymous ACME account and still obtains and renews certificates
# normally; the address only buys expiry warnings from Let's Encrypt. To set one,
# add a global options block above this one:
#
#   {
#       email you@example.com
#   }
{$DOMAIN} {
	encode gzip zstd

	# --- API ------------------------------------------------------------------
	# The backend owns several top-level prefixes, not just /api. Keep this list
	# in step with server/main.ts or a route will 404 as a missing static file.
	# Prefixes the API owns outright. None of these collide with a client route:
	# the console nests every authenticated page under /app.
	@api path /api/* /complaints/* /users/* /ai/* /maps/* /analytics/* /audit/* /timeline/* /gamification/* /storage/* /uploads/*
	handle @api {
		reverse_proxy api:3000
	}

	# /auth is the one prefix both sides claim, and only because they now share
	# an origin — split across two hosts this never came up. The console has page
	# routes at /auth/login, /auth/register, /auth/verify and
	# /auth/forgot-password; the API has endpoints at those same paths.
	#
	# Method separates them cleanly rather than by luck: every endpoint on
	# authentication.controller.ts is a POST except GET /auth/me. So writes go to
	# the API, /auth/me goes to the API, and a plain GET falls through to the SPA
	# to be rendered as a page.
	#
	# Adding a GET endpoint under /auth means adding it here too, or it will
	# silently return index.html with a 200 instead of the intended JSON.
	#
	# OPTIONS belongs here as well, and its absence was invisible until a second
	# origin existed. A browser preflights a cross-origin POST with OPTIONS; with
	# that verb falling through to the static handler, Caddy answered 405 with
	# "allow: GET, HEAD" and no CORS headers, so the request was blocked before
	# the API ever saw it. The console never noticed because same-origin requests
	# are not preflighted. The app, on app.<host>, is a different origin and is.
	#
	# There is no ambiguity to preserve: the SPA has no use for OPTIONS, so every
	# one of them under /auth is a preflight for an API call.
	@auth_api {
		path /auth/*
		method POST PUT PATCH DELETE OPTIONS
	}
	handle @auth_api {
		reverse_proxy api:3000
	}
	handle /auth/me {
		reverse_proxy api:3000
	}

	# --- Photographs ----------------------------------------------------------
	# Public reads from MinIO. The bucket is anonymous-read for this prefix, so
	# the browser can render a complaint photo and the CV service can fetch it by
	# URL without either holding a credential.
	#
	# GET and HEAD only. MinIO's S3 API is the same endpoint for writes, and
	# proxying it wholesale would let anyone PUT or DELETE objects — uploads must
	# go through the API, which authenticates the user first.
	@files_read {
		path /files/*
		method GET HEAD
	}
	handle @files_read {
		uri strip_prefix /files
		reverse_proxy minio:9000
	}
	# Anything else under /files is a write attempt. Refuse it outright rather
	# than falling through to the SPA and answering 200 with index.html.
	handle /files/* {
		respond "Method not allowed" 405
	}

	# --- Android app download ----------------------------------------------------
	# The APK is served from this box rather than linked from Expo's build servers,
	# whose artifact URLs expire after about thirty days. Here the link lives as
	# long as the instance does, and re-releasing is a file copy into ./downloads.
	#
	# Explicit Content-Type: Caddy would otherwise guess application/octet-stream
	# from the extension, and some Android browsers refuse to hand an octet-stream
	# to the package installer, silently saving it as an unopenable file instead.
	@apk path /lumen.apk
	handle @apk {
		root * /srv/downloads
		header Content-Type application/vnd.android.package-archive
		header Content-Disposition "attachment; filename=lumen.apk"
		# No long cache: this path is a moving target across releases, and a stale
		# cached copy would install an old build with no indication anything is old.
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	handle /download* {
		root * /srv/downloads
		try_files {path} /index.html
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# --- Socket.IO ------------------------------------------------------------
	# Long-lived upgrades. Caddy proxies WebSockets natively; the only thing that
	# matters is not buffering or timing them out.
	handle /socket.io/* {
		reverse_proxy api:3000
	}

	# --- Web console ----------------------------------------------------------
	# try_files sends unknown paths to index.html so client-side routes like
	# /app/dashboard survive a refresh or a shared deep link.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server

		# Hashed asset filenames change whenever their contents change, so they
		# can be cached permanently.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html must not be cached: it is what points at the current bundle.
		@html path / /index.html
		header @html Cache-Control "no-cache, no-store, must-revalidate"
	}

	header {
		# HSTS is deliberately absent: it is hard to undo, and a college demo on a
		# DuckDNS subdomain does not want a browser pinned to HTTPS for a year.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# The citizen mobile app, exported for the web.
#
# Its own hostname rather than a path on the console's, because the export
# generates absolute routes — /(citizen)/Dashboard and the like — and serving
# those under a subdirectory would need every one rewritten. sslip.io answers
# any prefix, so app.<ip>.sslip.io costs nothing and gets its own certificate.
#
# Same origin policy consequence worth knowing: this is a *different* origin
# from the console, so the app's requests to the API are cross-origin and
# depend on the backend's CORS allow-list including this host. FRONTEND_URL in
# the compose file carries it.
app.{$DOMAIN} {
	encode gzip zstd

	handle {
		root * /srv/app
		# Expo router is a single-page app: an unknown path is a client route,
		# not a missing file, so a deep link must still serve the document.
		try_files {path} {path}.html /index.html
		file_server

		@assets path /_expo/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@html path / /index.html
		header @html Cache-Control "no-cache, no-store, must-revalidate"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
