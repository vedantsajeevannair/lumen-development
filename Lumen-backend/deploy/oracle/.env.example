# ==============================================================================
# LUMEN — Oracle single-box deployment. Copy to .env and fill in.
#
# Only the variables that differ from a normal deployment are explained here;
# ../../.env.example documents the full set.
#
# DATABASE_URL, REDIS_URL, FASTAPI_INFERENCE_URL and FRONTEND_URL are NOT set
# here — docker-compose.prod.yml derives them from the values below, because
# every one of those services is a container on this box.
# ==============================================================================

# --- TLS ----------------------------------------------------------------------
# A real hostname. Let's Encrypt will not issue for a bare IP, so an OCI public
# IP alone is not enough — but you do not need to register a domain either.
# <public-ip>.sslip.io resolves to the IP embedded in the name, which is what
# the live deployment uses. A free DuckDNS subdomain works equally well.
DOMAIN=140.238.250.246.sslip.io
# Optional. Expiry notices from Let's Encrypt; leave empty for an anonymous
# ACME account. Renewal is automatic either way.
TLS_EMAIL=

# --- Postgres -----------------------------------------------------------------
# Consumed by both the postgres container and the API's DATABASE_URL. The
# database is not published outside the compose network, but this is still the
# credential protecting every complaint record on the box — generate it, do not
# invent it:  openssl rand -base64 24
DB_USER=lumen
DB_PASSWORD=
DB_NAME=lumen_db

# --- Auth ---------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# --- CV service ---------------------------------------------------------------
# The service is not published to the host and is only reachable at
# http://fastapi:8000 on the compose network, so this guards against nothing
# outside the box. Set anyway — it costs nothing and stops another container
# from calling it by accident.  openssl rand -hex 32
FASTAPI_API_KEY=
# The exported ONNX graph bakes in nms=True at conf=0.001, so this is the only
# threshold that actually filters detections.
CONFIDENCE_THRESHOLD=0.25

# --- Object storage (complaint photographs) -----------------------------------
# MinIO runs as a container here and speaks the S3 API the StorageService
# already targets, so no managed bucket is involved. These root credentials
# double as the access key pair the API signs uploads with — generate the
# password, do not invent it:  openssl rand -base64 24
#
# docker-compose.prod.yml derives STORAGE_ENDPOINT (internal) and
# STORAGE_PUBLIC_BASE_URL (through Caddy at /files) from these; do not set them
# here or the two addresses will disagree.
MINIO_ROOT_USER=lumen
MINIO_ROOT_PASSWORD=
STORAGE_BUCKET_NAME=lumen-storage

# --- SMTP (OTP + notification mail) -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Google Maps --------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Build contexts -----------------------------------------------------------
# Where the backend source sits relative to this file. The defaults assume the
# repo layout (this file lives at Lumen-backend/deploy/oracle/). On the instance
# the deploy files and a copy of the source sit side by side under /opt/lumen
# instead, so both are repointed:
#
#   BACKEND_CONTEXT=./src
#   AI_CONTEXT=./src/server/ai/python
BACKEND_CONTEXT=../..
AI_CONTEXT=../../server/ai/python

# --- Backups ------------------------------------------------------------------
# Pre-authenticated request URL for the OCI Object Storage backup bucket, used
# by backup.sh. Scope it to AnyObjectWrite so a compromised box can add backups
# but cannot read, list or delete them:
#
#   oci os preauth-request create --namespace <ns> --bucket-name lumen-backups \
#     --name lumen-box-backup-writer --access-type AnyObjectWrite \
#     --time-expires 2028-01-01T00:00:00Z
#
# The returned access-uri is a PATH, not a URL. Prefix it with the regional
# endpoint or curl rejects it:
#   https://objectstorage.<region>.oraclecloud.com/p/<token>/n/<ns>/b/<bucket>/o/
BACKUP_PAR_URL=
