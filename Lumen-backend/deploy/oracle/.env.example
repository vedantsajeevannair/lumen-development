# ==============================================================================
# LUMEN — Oracle single-box deployment. Copy to .env and fill in.
#
# Only the variables that differ from a normal deployment are explained here;
# ../../.env.example documents the full set.
#
# DATABASE_URL, REDIS_URL, FASTAPI_INFERENCE_URL and FRONTEND_URL are NOT set
# here — docker-compose.prod.yml derives them from the values below, because
# every one of those services is a container on this box.
# ==============================================================================

# --- TLS ----------------------------------------------------------------------
# A real hostname. Let's Encrypt will not issue for a bare IP, so an OCI public
# IP alone is not enough. A free DuckDNS subdomain works: lumen.duckdns.org
DOMAIN=lumen.duckdns.org
# Expiry and problem notices from Let's Encrypt.
TLS_EMAIL=you@example.com

# --- Postgres -----------------------------------------------------------------
# Consumed by both the postgres container and the API's DATABASE_URL. The
# database is not published outside the compose network, but this is still the
# credential protecting every complaint record on the box — generate it, do not
# invent it:  openssl rand -base64 24
DB_USER=lumen
DB_PASSWORD=
DB_NAME=lumen_db

# --- Auth ---------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# --- Supabase -----------------------------------------------------------------
# Read only by the health probe, but env.validation.ts refuses to boot without
# both, and SUPABASE_URL must parse as a URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# --- CV service ---------------------------------------------------------------
# Left empty on purpose. The service is not published to the host and is only
# reachable at http://fastapi:8000 on the compose network, so there is no
# untrusted path to it — the same reasoning that makes it optional on EKS.
# Set it on both sides if you ever publish that port.
FASTAPI_API_KEY=
CONFIDENCE_THRESHOLD=0.60

# --- S3 (complaint media) -----------------------------------------------------
# No instance role here, so static keys are required. Scope the IAM user to
# GetObject/PutObject/DeleteObject on this one bucket.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SMTP (OTP + notification mail) -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Google Maps --------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
