# LUMEN Client Environment Variables
# Copy this file to .env for local development.
# Expo only exposes EXPO_PUBLIC_* to the app bundle — never put a secret here,
# it ships to the device. These are inlined at build time, so a release build
# must be rebuilt when the backend URL changes.

# Base URL of the LUMEN backend (the same API the web app uses).
#   hosted:            https://backend.render.com
#   local (iOS sim):   http://localhost:3000
#   local (Android):   http://localhost:3000   ← rewritten to 10.0.2.2 automatically
EXPO_PUBLIC_API_URL=https://backend.render.com

# WebSocket endpoint for live sync/notifications.
# Defaults to EXPO_PUBLIC_API_URL when left empty.
EXPO_PUBLIC_SOCKET_URL=

# Google Maps — used by the map screens for tiles and geocoding.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase — read by the client for storage/session helpers.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
